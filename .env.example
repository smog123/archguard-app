# Archguard Monorepo Environment Configuration

# Stellar Network Environment (testnet | mainnet)
STELLAR_NETWORK=testnet

# Soroban RPC URL endpoint
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Network Passphrase matching STELLAR_NETWORK
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Deployed Contract Addresses (Set to PENDING_DEPLOYMENT until Phase 8 deployment)
ARCHGUARD_REGISTRY_CONTRACT_ID=PENDING_DEPLOYMENT
ARCHGUARD_EXTENDER_CONTRACT_ID=PENDING_DEPLOYMENT

# Keeper (Indexer) Service Configuration
# NEVER expose KEEPER_OPERATOR_SECRET to apps/web!
KEEPER_OPERATOR_SECRET=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
INDEXER_POLL_INTERVAL_SECONDS=300
WEBHOOK_DB_URL=webhooks.db

# Client-Exposed Environment Variables for Next.js Web App
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
NEXT_PUBLIC_ARCHGUARD_REGISTRY_CONTRACT_ID=PENDING_DEPLOYMENT
NEXT_PUBLIC_ARCHGUARD_EXTENDER_CONTRACT_ID=PENDING_DEPLOYMENT
