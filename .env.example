# Archguard Monorepo Environment Configuration

# Stellar Network Environment (testnet | mainnet)
STELLAR_NETWORK=testnet

# Soroban RPC URL endpoint
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Network Passphrase matching STELLAR_NETWORK
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Deployed Contract Addresses (Stellar Testnet)
ARCHGUARD_REGISTRY_CONTRACT_ID=CDAONHGO63LZKXO42LJTZWGFP5VZRZJXREMU7VCAWDILXKHSPBZXZ6RA
ARCHGUARD_EXTENDER_CONTRACT_ID=CBCK4CYVWNPVC3SJAQXUYYZUOWEKX7DQQJNNU25KZWHD43TICNIORWRF

# Keeper (Indexer) Service Configuration
# NEVER expose KEEPER_OPERATOR_SECRET to apps/web!
KEEPER_OPERATOR_SECRET=<your-keeper-operator-secret-key>
INDEXER_POLL_INTERVAL_SECONDS=300
WEBHOOK_DB_URL=./indexer-data/webhooks.sqlite

# Client-Exposed Environment Variables for Next.js Web App
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
NEXT_PUBLIC_ARCHGUARD_REGISTRY_CONTRACT_ID=CDAONHGO63LZKXO42LJTZWGFP5VZRZJXREMU7VCAWDILXKHSPBZXZ6RA
NEXT_PUBLIC_ARCHGUARD_EXTENDER_CONTRACT_ID=CBCK4CYVWNPVC3SJAQXUYYZUOWEKX7DQQJNNU25KZWHD43TICNIORWRF
